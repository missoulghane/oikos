# Copier en .env (jamais commité, voir .gitignore) et remplir avant
# `docker compose up --build`. Voir README.md, section "Docker / recette".
#
# Les variables applicatives d'oikos-api (JWT_SECRET, MAIL_*, APP_*_BASE_URL,
# ...) sont dans oikos-api/.env.example, pas ici : ce fichier ne couvre que
# ce qui est partagé entre services ou propre à l'orchestration Docker.

# --- Base de données (conteneur postgres + datasource de l'API, service
#     flyway) ---
POSTGRES_DB=oikos
POSTGRES_USER=oikos
POSTGRES_PASSWORD=changeme

# --- Web (oikos-web) ---
# URL de l'API telle qu'atteinte par le navigateur (pas le réseau interne
# Docker) - bakée en dur au build de l'image, doit correspondre au port hôte
# publié par le service "api" dans docker-compose.yml (local), ou au domaine
# public de l'API pour un déploiement recette/prod du même docker-compose.
VITE_API_URL=http://localhost:8080/api/v1
