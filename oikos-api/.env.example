# Copier en .env (jamais commité) pour toute exécution du profil `docker`
# (local via `docker compose up`, ou sur un vrai serveur - recette/prod - qui
# réutilise les mêmes Dockerfiles/docker-compose.yml avec ce fichier rempli
# de vraies valeurs). Le profil `dev` (`./mvnw spring-boot:run`) n'a besoin
# d'aucune de ces variables (mail désactivé, base H2 en mémoire).
#
# Les identifiants Postgres (POSTGRES_DB/USER/PASSWORD) sont dans le .env
# racine, pas ici : ils sont partagés entre le conteneur postgres et cette
# API, un seul endroit pour éviter que les deux divergent.

# --- Sécurité ---
JWT_SECRET=change-me-change-me-change-me-change-me-32bytes
# Origines autorisées en CORS pour oikos-web (liste séparée par des virgules).
# Par défaut (non défini ici) : http://localhost:*,http://127.0.0.1:* - ne
# marche qu'en local. Recette/prod DOIVENT la surcharger avec l'origine
# publique réelle, sous peine de "Invalid CORS request" au login.
# Local (docker compose up) : pas besoin, le défaut localhost suffit.
# Recette (VPS Hostinger) :
# APP_CORS_ALLOWED_ORIGINS=https://oikos-staging.tech
# Prod (TODO: idem avec le domaine de production définitif)

# --- Email (compte Gmail, mot de passe d'application - jamais le mot de
#     passe du compte) ---
MAIL_USERNAME=contact@oikos-staging.tech
MAIL_PASSWORD=<Password d'application Hostinger pour contact@oikos-staging.tech>
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_FROM=contact@oikos-staging.tech
MAIL_ENABLED=true

# --- Liens envoyés aux utilisateurs (emails de vérification, d'activation,
#     d'invitation, de mot de passe oublié ; lien de confirmation de présence
#     imprimé sur les convocations et encodé dans leur QR code).
#
#     UNE SEULE VARIABLE À DÉFINIR : l'origine PUBLIQUE d'oikos-web pour cet
#     environnement. Tous les liens en dérivent.
#
#     Elle n'a pas toujours existé : chaque lien avait sa variable, et en
#     oublier une ne cassait rien au démarrage — le destinataire recevait
#     simplement un lien vers localhost. C'est arrivé en recette avec le lien
#     de confirmation des convocations. Une variable unique, et un nouveau type
#     de lien hérite d'office.  ---
# Local (docker compose up) : oikos-web est exposé sur 8082.
APP_PUBLIC_BASE_URL=http://localhost:8082
# Recette (VPS Hostinger, voir docker-compose.staging.yml) :
# APP_PUBLIC_BASE_URL=https://oikos-staging.tech
# Prod (TODO: idem avec le domaine de production définitif)
#
# Surcharges individuelles, facultatives : uniquement si UN lien doit pointer
# ailleurs que le reste. Ne les définissez pas « pour faire complet » — c'est
# la duplication qui a créé le problème ci-dessus.
# APP_VERIFICATION_BASE_URL=…/verify-email
# APP_ACCOUNT_ACTIVATION_BASE_URL=…/activate-account
# APP_PASSWORD_RESET_BASE_URL=…/reset-password
# APP_PARTY_INVITATION_BASE_URL=…/accept-invitation
# APP_INVITATION_BASE_URL=…/invitations
# APP_CONVOCATION_CONFIRMATION_BASE_URL=…/convocations/confirmation

# --- Optionnel (valeurs par défaut déjà correctes pour la plupart des cas,
#     décommenter pour surcharger) ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_FROM=no-reply@oikos.ma
# MAIL_ENABLED=true
# STORAGE_TYPE=local
# STORAGE_LOCAL_BASE_DIR=./data/documents
# DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
# AVATAR_MAX_FILE_SIZE_BYTES=2097152
# PUSH_ENABLED=false

# --- Mode de déploiement -------------------------------------------------
# Vide (ou absent) = mode normal : le schéma vient de Flyway (V1__baseline.sql)
# et les données de l'environnement sont conservées d'un déploiement à l'autre.
#
# demo = mode DEV : à chaque déploiement, le service `demo-seed` vide les
# données métier et recharge db/dev/dev.sql (8 profils copropriétaire/conseil
# fictifs, 3 résidences, 14 lots). Le schéma et les données de référence
# (permissions, journaux, catalogues) ne sont PAS touchés - ils restent ceux
# que Flyway a posés.
#
# ATTENTION : en mode demo, toute donnée saisie en recette est effacée au
# déploiement suivant. C'est le but, mais ça se décide.
#
# Cette valeur vit ici et non dans docker-compose.yml délibérément : le compose
# est versionné et partagé par tous les environnements, alors que le mode est
# une propriété de CET environnement-ci.
COMPOSE_PROFILES=

