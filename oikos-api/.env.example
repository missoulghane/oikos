# Copier en .env (jamais commité) pour toute exécution du profil `docker`
# (local via `docker compose up`, ou sur un vrai serveur - recette/prod - qui
# réutilise les mêmes Dockerfiles/docker-compose.yml avec ce fichier rempli
# de vraies valeurs). Le profil `dev` (`./mvnw spring-boot:run`) n'a besoin
# d'aucune de ces variables (mail désactivé, base H2 en mémoire).
#
# Les identifiants Postgres (POSTGRES_DB/USER/PASSWORD) sont dans le .env
# racine, pas ici : ils sont partagés entre le conteneur postgres et cette
# API, un seul endroit pour éviter que les deux divergent.

# --- Sécurité ---
JWT_SECRET=change-me-change-me-change-me-change-me-32bytes
# Origines autorisées en CORS pour oikos-web (liste séparée par des virgules).
# Par défaut (non défini ici) : http://localhost:*,http://127.0.0.1:* - ne
# marche qu'en local. Recette/prod DOIVENT la surcharger avec l'origine
# publique réelle, sous peine de "Invalid CORS request" au login.
# Local (docker compose up) : pas besoin, le défaut localhost suffit.
# Recette (VPS Hostinger) :
# APP_CORS_ALLOWED_ORIGINS=https://oikos-staging.tech
# Prod (TODO: idem avec le domaine de production définitif)

# --- Email (compte Gmail, mot de passe d'application - jamais le mot de
#     passe du compte) ---
MAIL_USERNAME=contact@oikos-staging.tech
MAIL_PASSWORD=<Password d'application Hostinger pour contact@oikos-staging.tech>
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_FROM=contact@oikos-staging.tech
MAIL_ENABLED=true

# --- Liens dans les emails envoyés (vérification, activation, invitations,
#     mot de passe oublié) - doivent pointer vers l'URL PUBLIQUE d'oikos-web
#     pour cet environnement, pas vers un nom de service Docker interne. ---
# Local (docker compose up) :
APP_VERIFICATION_BASE_URL=http://localhost:8082/verify-email
APP_ACCOUNT_ACTIVATION_BASE_URL=http://localhost:8082/activate-account
APP_PASSWORD_RESET_BASE_URL=http://localhost:8082/reset-password
APP_PARTY_INVITATION_BASE_URL=http://localhost:8082/accept-invitation
APP_INVITATION_BASE_URL=http://localhost:8082/invitations
# Recette (VPS Hostinger, voir docker-compose.staging.yml) :
# APP_VERIFICATION_BASE_URL=https://oikos-staging.tech/verify-email
# APP_ACCOUNT_ACTIVATION_BASE_URL=https://oikos-staging.tech/activate-account
# APP_PASSWORD_RESET_BASE_URL=https://oikos-staging.tech/reset-password
# APP_PARTY_INVITATION_BASE_URL=https://oikos-staging.tech/accept-invitation
# APP_INVITATION_BASE_URL=https://oikos-staging.tech/invitations
# Prod (TODO: idem avec le domaine de production définitif)

# --- Optionnel (valeurs par défaut déjà correctes pour la plupart des cas,
#     décommenter pour surcharger) ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_FROM=no-reply@oikos.ma
# MAIL_ENABLED=true
# STORAGE_TYPE=local
# STORAGE_LOCAL_BASE_DIR=./data/documents
# DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
# AVATAR_MAX_FILE_SIZE_BYTES=2097152
# PUSH_ENABLED=false
