EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# Optionnelle : adresse citée dans le message d'erreur générique.
# Par défaut support@daba-syndic.com (voir src/config/env.ts).
EXPO_PUBLIC_SUPPORT_EMAIL=support@daba-syndic.com
# Optionnelle : site web qui sert les CGU et CGV ouvertes depuis l'inscription.
# Par défaut https://daba-syndic.com (voir src/config/env.ts).
EXPO_PUBLIC_WEB_URL=https://daba-syndic.com
