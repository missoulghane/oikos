# Normalize line endings to LF for text files, regardless of the OS
# checking them out (avoids noisy diffs between macOS/Linux/Windows).
* text=auto eol=lf

# Windows-specific scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff/convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# SVGs are text but should keep LF, not be treated as binary.
*.svg text eol=lf
