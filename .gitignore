# =============================================================================
# Root .gitignore for the oikos monorepo (oikos-api, oikos-mobile, oikos-web).
#
# Single source of truth: patterns without a leading "/" match at any depth,
# so per-project rules live here too instead of being duplicated in each
# sub-project's own .gitignore.
# =============================================================================

### Environment / secrets ###
.env
.env.local
.env.*.local
*.local

### Working notes with credentials (never track, see history for the original) ###
users.tests

### Logs ###
*.log
logs/

### Claude Code (personal, machine-specific overrides - settings.json stays shared) ###
.claude/settings.local.json

### Editors / IDE ###
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*.swn

### macOS ###
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### Windows ###
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

### Linux ###
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

### Archives / temp files ###
*.bak
*.tmp
*.temp
*.orig

# =============================================================================
# oikos-api (Spring Boot / Maven)
# =============================================================================
HELP.md
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Local secrets/overrides
application-local.yml
application-local.yaml
application-local.properties

# STS / IntelliJ / NetBeans
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
.idea
*.iws
*.ipr
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# =============================================================================
# oikos-mobile (Expo / React Native)
# =============================================================================
node_modules/
.expo/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# typescript
*.tsbuildinfo

# generated native folders
/oikos-mobile/ios
/oikos-mobile/android

# =============================================================================
# oikos-web (Vite / React)
# =============================================================================
dist/
dist-ssr/
pnpm-debug.log*
lerna-debug.log*

# Tests / coverage
coverage/
.nyc_output/
